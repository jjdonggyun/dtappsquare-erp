NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3200
# Optional comma-separated additional browser origins, including scheme and port.
# Example: http://127.0.0.1:3200,http://192.168.1.141:3200
APP_ALLOWED_ORIGINS=
COMPANY_TIMEZONE=Asia/Seoul
# Optional trusted attendance IP used by localhost/LAN `next dev`; ignored outside development.
ATTENDANCE_DEV_CLIENT_IP=
EMAIL_PROVIDER=DISABLED
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DISPATCH_SECRET=
# Vercel/internal scheduler bearer secret for monthly card settlement and weekday operational alerts (32+ chars).
CRON_SECRET=
# Local integration tests and seed only. Never use production credentials here.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
SEED_PASSWORD=
